# ============================================================
# ImportFlow ERP — Environment Configuration Template
# Copy this file to .env and configure secret keys for your environment.
# NEVER commit production secrets or credentials to source control.
# ============================================================

# Application & Security
# REQUIRED: Must be at least 32 characters. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-secure-random-32-byte-secret-key
# For local desktop ERP usage set to true. Set to false for web-exposed deployments.
ALLOW_DEV_AUTH_BYPASS=true
DEBUG=false

# Database Configuration
DATABASE_PATH=sorour_logistics.db

# External Integrations (Customs, CargoX, Nafeza)
NAFEZA_API_KEY=
CARGOX_API_TOKEN=
EGY_TRUST_PKI_KEY=

# AI Document Extraction Services (Optional)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
